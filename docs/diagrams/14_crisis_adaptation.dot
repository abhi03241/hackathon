digraph CrisisAdaptationArchitecture {
    graph [
        label="NG Yoga Studio -- Crisis Adaptation Architecture (Human-Led vs Generic AI)"
        labelloc=t
        fontname="Helvetica"
        fontsize=16
        rankdir=LR
        splines=ortho
        pad=0.8
        nodesep=0.9
        ranksep=1.3
        bgcolor="white"
    ]
    node [fontname="Helvetica" fontsize=10]
    edge [fontname="Helvetica" fontsize=9]

    // Crisis Context
    subgraph cluster_market {
        label="Market Crisis: The Great Compression"
        style=rounded
        color="#DC2626"
        penwidth=2
        fontcolor="#DC2626"
        bgcolor="#FEF2F2"

        node [shape=box style=filled fillcolor="#FEE2E2" color="#DC2626"]
        M1 [label="Generic AI Apps (Rs 299/mo)\nAlgorithmic Pose Estimation\nNo Safety Guarantees\nZero Condition Triage"]
        M2 [label="Churn Reality\nMembers: 180 -> 95\nInstructor Insecurity\nPerceived Commodity Yoga"]
    }

    // Core Differentiation
    subgraph cluster_diff {
        label="Strategic Moat: Safe, Human-Led Clinical Yoga"
        style=rounded
        color="#059669"
        penwidth=2
        fontcolor="#059669"
        bgcolor="#ECFDF5"

        node [shape=box style=filled fillcolor="#D1FAE5" color="#059669"]
        D1 [label="Clinical Routing Rules\nR1..R6 Hard Guarantees\nLiability & Injury Shield"]
        D2 [label="Human-Led Value Prop\nAlignment Correction (Iyengar)\nSpecialist Care (PCOD, Therapy)\nMicro-Group Sessions (<=10% fee cap)"]
    }

    // New System Components
    subgraph cluster_engine {
        label="System Adaptation Modules"
        style=rounded
        color="#2563EB"
        penwidth=2
        fontcolor="#2563EB"
        bgcolor="#EFF6FF"

        node [shape=box style=filled fillcolor="#DBEAFE" color="#2563EB"]
        E1 [label="Unified Retention Risk Engine\nRisk Scoring:\n- Expiry <= 7 days (Score 3)\n- Inactivity >= 7 days (Score 4)\n- Unconverted Trial (Score 5)"]
        E2 [label="Contextual WhatsApp Engine\nPersonalized Value Templates:\n- Inactive Recovery + Micro-Group Pass\n- Pre-Expiry Renewal + 1-on-1 Check\n- Trial Conversion + Safety Fit"]
        E3 [label="Member Programme-Fit Explainer\n'Why Human-Led Matters'\nDisplays Custom Instructor Safeguards"]
    }

    // Front-Office Dashboard
    subgraph cluster_dashboard {
        label="Operational Front-Desk & Retention Board"
        style=rounded
        color="#7C3AED"
        penwidth=2
        fontcolor="#7C3AED"
        bgcolor="#F5F3FF"

        node [shape=box style=filled fillcolor="#EDE9FE" color="#7C3AED"]
        DB1 [label="Priority Action Queue\nRanked by Risk Score\nDirect One-Click WhatsApp CTA"]
        DB2 [label="Instructor Schedule Shield\nProtects Staff Roster for 90 Days\nFills Small Group Batches"]
    }

    // Connections
    M1 -> M2 [label="Triggers Churn" color="#DC2626"]
    M2 -> E1 [label="Ingests Raw Signals" color="#DC2626"]
    D1 -> E3 [label="Populates Safety Badges" color="#059669"]
    D2 -> E3 [label="Injects Human Value Narrative" color="#059669"]
    E1 -> DB1 [label="Feeds Ranked Queue" color="#2563EB"]
    E2 -> DB1 [label="Attaches Pre-formatted Deep Link" color="#2563EB"]
    DB1 -> DB2 [label="Re-engages Members into Batches" color="#7C3AED"]
}
