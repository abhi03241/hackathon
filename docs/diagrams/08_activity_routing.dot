digraph ActivityRoutingEngine {
    graph [
        label="Activity Diagram -- Programme Routing Engine (R1-R6)"
        labelloc=t
        fontname="Helvetica"
        fontsize=15
        rankdir=TB
        splines=ortho
        nodesep=0.7
        ranksep=0.7
        bgcolor="white"
    ]
    node [fontname="Helvetica" fontsize=10]
    edge [fontname="Helvetica" fontsize=9]

    // Start
    start [shape=circle style=filled fillcolor=black width=0.3 label=""]

    // Decision diamonds
    node [shape=diamond style=filled fillcolor="#FEF3C7" color="#D97706" penwidth=2]
    D1 [label="conditions\ncontains\nPREGNANCY?"]
    D2 [label="conditions contains\nBACK_PAIN\nor KNEE_PAIN?"]
    D3 [label="conditions\ncontains\nHIGH_BP?"]
    D4 [label="conditions\ncontains\nPCOD?"]
    D5 [label="conditions = NONE\nAND goal =\nWEIGHT_LOSS?"]
    D6 [label="experience =\nBEGINNER?"]

    // Actions
    node [shape=box style=filled fillcolor="#DBEAFE" color="#1D4ED8" penwidth=1.5]
    A1  [label="R1: HARD BLOCK\nSet hardBlock = true\nBlock ALL programmes\nMessage: 'Please speak\nto an instructor'"]
    A2  [label="R2: Block POWER, ADVANCED\nSet recommended = YOGA_THERAPY"]
    A3  [label="R3: Block POWER, ADVANCED\nIf recommended not set:\nrecommended = TRADITIONAL"]
    A4  [label="R4: Set recommended = PCOD"]
    A5  [label="R5: Set recommended = WEIGHT_LOSS"]
    A6  [label="R6: Block ADVANCED"]

    // Merge / output
    node [shape=box style=filled fillcolor="#D1FAE5" color="#065F46" penwidth=2]
    OUT [label="Compute allowed[] =\nALL_PROGRAMMES minus blocked\n\nReturn:\n{recommended, allowed[], blocked[], hardBlock, message}"]

    // End
    end_hard  [shape=doublecircle style=filled fillcolor=black width=0.3 label=""]
    end_normal [shape=doublecircle style=filled fillcolor=black width=0.3 label=""]

    // Init action
    node [shape=box style=filled fillcolor="#F3F4F6" color="#6B7280"]
    INIT [label="Receive RoutingInput:\n{conditions[], goal, experienceLevel}"]
    INIT_BLOCK [label="Initialize:\nblocked = Set{}\nrecommended = TRADITIONAL\nhardBlock = false"]

    start -> INIT
    INIT -> INIT_BLOCK
    INIT_BLOCK -> D1

    D1 -> A1 [label="YES" color=red]
    D1 -> D2 [label="NO"]

    A1 -> end_hard

    D2 -> A2 [label="YES" color=red]
    D2 -> D3 [label="NO"]

    A2 -> D3

    D3 -> A3 [label="YES" color=red]
    D3 -> D4 [label="NO"]

    A3 -> D4

    D4 -> A4 [label="YES" color="#D97706"]
    D4 -> D5 [label="NO"]

    A4 -> D6

    D5 -> A5 [label="YES" color="#059669"]
    D5 -> D6 [label="NO (skip R5)"]

    A5 -> D6

    D6 -> A6 [label="YES" color=red]
    D6 -> OUT [label="NO"]

    A6 -> OUT

    OUT -> end_normal
}
